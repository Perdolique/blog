---
import { Icon } from 'astro-icon/components'
import type { Locale } from '@/i18n/config'
import { ui } from '@/i18n/ui'
import Panel from './Panel.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const translations = ui[locale]
---

<Panel tag="section" class="panel">
  <h2>{translations.aboutHeading}</h2>

  <div class="content">
    <p>{translations.aboutDescription}</p>

    <p>
      <Icon size="24" name="streamline-emojis:teacup-without-handle" />
      <Icon size="24" name="skill-icons:typescript" />
    </p>
  </div>
</Panel>

<style>
  .panel {
    display: grid;
    row-gap: var(--spacing-16);

    @container (width > 600px) {
      row-gap: var(--spacing-24);
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  p {
    margin: 0;
    line-height: 1.5;
  }
</style>
