---
import type { Locale } from '@/i18n/config'
import { ui } from '@/i18n/ui'
import Panel from './Panel.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<Panel class="panel">
  {ui[locale].noLatestPosts}
</Panel>

<style>
  .panel {
    padding: var(--spacing-48);
    text-align: center;
  }
</style>
