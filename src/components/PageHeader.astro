---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '@/i18n/config'
import { ui } from '@/i18n/ui'
import LanguageSwitcher from './LanguageSwitcher.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  locale: Locale
  localizedPath: string
}

const { locale, localizedPath } = Astro.props
const translations = ui[locale]
---

<header>
  <div class="content">
    <a href={getRelativeLocaleUrl(locale, '')}>
      <img src="/perdolique.png" alt={translations.logoAlt} width="32" height="32" />
    </a>

    <div class="actions">
      <LanguageSwitcher locale={locale} localizedPath={localizedPath} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: center;
    padding: var(--spacing-8) 0;
    backdrop-filter: blur(4px);
    background-color: light-dark(oklch(100% 0 0 / 0.86), oklch(20.58% 0.02 270.36 / 0.72));
    border-bottom: 1px solid light-dark(oklch(22.61% 0.02 264.02 / 0.08), oklch(95.38% 0.02 274.74 / 0.12));
  }

  .content {
    max-width: var(--max-width);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .actions {
    display: flex;
    align-items: center;
    column-gap: var(--spacing-8);
  }

  a {
    border-radius: var(--border-radius-8);
    line-height: 0;

    &:focus-visible {
      outline: var(--outline);
      outline-offset: var(--outline-offset);
    }
  }

  img {
    @media (prefers-color-scheme: dark) {
      filter: invert(100%);
    }

    html[style*="--color-scheme: 🌚"] & {
      filter: invert(100%);
    }

    html[style*="--color-scheme: 🌞"] & {
      filter: none;
    }
  }
</style>
