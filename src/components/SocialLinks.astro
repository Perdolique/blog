---
import type { Locale } from '@/i18n/config'
import SocialButton from './SocialButton.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div>
  <SocialButton type="github" locale={locale} />
  <SocialButton type="linkedin" locale={locale} />
  <SocialButton type="twitch" locale={locale} />
  <SocialButton type="telegram" locale={locale} />
</div>

<style>
  div {
    display: flex;
    container-type: inline-size;
  }
</style>
