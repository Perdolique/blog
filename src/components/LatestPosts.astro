---
import type { LocalizedBlogPost } from '@/i18n/blog-posts'
import type { Locale } from '@/i18n/config'
import LatestPost from './LatestPost.astro'

interface Props {
  posts: LocalizedBlogPost[]
  locale: Locale
}

const { posts, locale } = Astro.props
---

<div class="latest-posts">
  {posts.map((post) => (
    <LatestPost
      title={post.entry.data.title}
      description={post.entry.data.description}
      slug={post.slug}
      date={post.entry.data.date}
      locale={locale}
    />
  ))}
</div>

<style>
  .latest-posts {
    display: grid;
    row-gap: var(--spacing-16);
  }
</style>
